      },
      "levels": {
        "beginner": {
          "description": "Menguasai dasar JavaScript dan konsep pemrograman fundamental.",
          "indicators": [
            "memahami variable (let, const)",
            "memahami tipe data primitif",
            "menggunakan operator dan conditional",
            "menggunakan loop (for, while)",
            "membuat function sederhana",
            "menggunakan array dan object dasar",
            "mengerti error dasar dan console.log debugging"
          ]
        },
        "intermediate": {
          "description": "Menguasai JavaScript modern (ES6), asynchronous programming, dan manipulasi DOM.",
          "indicators": [
            "menguasai arrow function",
            "menggunakan map, filter, reduce",
            "memahami promise dan async/await",
            "menggunakan fetch API untuk HTTP request",
            "memahami event loop dan execution order",
            "melakukan DOM manipulation (querySelector, classList)",
            "mengerti module import/export"
          ]
        },
        "advanced": {
          "description": "Memahami mekanisme internal JavaScript dan dapat mengoptimasi kode.",
          "indicators": [
            "mengerti closure dan lexical scope",
            "memahami this binding dan prototype inheritance",
            "menguasai advanced asynchronous patterns",
            "menerapkan debouncing dan throttling",
            "mengoptimasi event handling",
            "menguasai error handling lanjutan",
            "mengerti memory leaks dan optimisasi performa JS"
          ]
        }
      }
    },
