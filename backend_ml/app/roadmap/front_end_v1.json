    {
      "id": "html_css_fundamentals",
      "name": "HTML & CSS Fundamentals",
      "estimated_hours": 45,
      "priority": 1,
      "prerequisites": [],
      "next_steps": ["javascript_basics"],
      "keywords": [
        "html", "html5", "semantic", "semantic html", "dom",
        "web basics", "css", "css3", "flexbox", "grid",
        "responsive", "responsive design", "tailwind", "bootstrap", "layout"
      ],
      "mapped_courses": {
        "beginner": [ 
          "39", 
          "40"
        ],
        "intermediate": [
          "41"
        ],
        "advanced": [
          "42"
        ]
      },
      "levels": {
        "beginner": {
          "description": "Memahami struktur dasar HTML, dapat membuat layout sederhana, dan menggunakan CSS dasar untuk styling.",
          "indicators": [
            "mengetahui struktur dokumen HTML5",
            "menggunakan tag dasar seperti <div>, <p>, <h1>-<h6>, <a>, <img>",
            "mengerti perbedaan class dan id",
            "menggunakan CSS selectors dasar (class, id, tag)",
            "memahami box model (margin, padding, border)",
            "mampu membuat layout sederhana tanpa responsive",
            "mengerti apa itu external dan internal stylesheet"
          ]
        },
        "intermediate": {
          "description": "Mampu menuliskan semantic HTML, menguasai layout modern (Flexbox, Grid), dan membuat tampilan responsive.",
          "indicators": [
            "menggunakan semantic HTML secara konsisten (header, main, nav, section, article, footer)",
            "memahami pentingnya aksesibilitas HTML",
            "memahami DOM tree dan hubungan parent/child",
            "menguasai Flexbox dan Grid untuk layout kompleks",
            "menggunakan media queries untuk membuat tampilan responsive",
            "menggunakan CSS variables dan utility classes",
            "memahami prinsip desain responsif (fluid, adaptive, responsive)"
          ]
        },
        "advanced": {
          "description": "Mampu mengoptimasi performa CSS/HTML, membuat UI kompleks, memanipulasi layout secara dinamis, dan menerapkan praktik aksesibilitas modern.",
          "indicators": [
            "menerapkan praktik aksesibilitas WAI-ARIA",
            "mengerti dan mengoptimasi critical CSS",
            "menggunakan CSS animations, transitions, transform",
            "memahami CSS architecture (BEM, ITCSS, OOCSS)",
            "menggunakan pseudo-class dan pseudo-element lanjutan",
            "mampu meminimalkan reflow/repaint",
            "mengerti container queries dan layout modern baru"
          ]
        }
      }
    },
